{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "squash"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Test (Python 3.9, Linux)", "integration_id": 15368 },
          { "context": "Test (Python 3.13, Linux)", "integration_id": 15368 },
          { "context": "Test (Python 3.9, Windows)", "integration_id": 15368 },
          { "context": "Test (Python 3.13, Windows)", "integration_id": 15368 },
          { "context": "Shellcheck", "integration_id": 15368 },
          { "context": "PSScriptAnalyzer", "integration_id": 15368 },
          { "context": "install.sh (systemd)", "integration_id": 15368 },
          { "context": "install.ps1 (Task Scheduler)", "integration_id": 15368 },
          { "context": "Release build", "integration_id": 15368 },
          { "context": "Secrets (gitleaks)", "integration_id": 15368 },
          { "context": "Code (Semgrep)", "integration_id": 15368 },
          { "context": "Dependencies", "integration_id": 15368 }
        ]
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ]
}
